{
  "name": "@tcm-edu/monorepo",
  "version": "0.1.0",
  "description": "TCM-Edu frontend monorepo: student + admin + teacher apps sharing one RPC client.",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev:student": "pnpm --filter @tcm-edu/student dev",
    "dev:admin": "pnpm --filter @tcm-edu/admin dev",
    "dev:teacher": "pnpm --filter @tcm-edu/teacher dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
