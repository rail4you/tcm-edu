# ============================================================
# .env.example - tcm-edu 生产环境配置模板
# ============================================================
# 复制为 .env 并修改：
#   cp .env.example .env && vim .env
#
# 部署：
#   ./deploy.sh up
# ============================================================

# ─── 容器镜像 ──────────────────────────────────────────────────
IMAGE=registry.cn-zhangjiakou.aliyuncs.com/myelixir/tcm-edu:latest

# ─── 公开访问地址（不要带尾部斜杠；公网只开放 80/443，由 nginx 反代）──
PUBLIC_URL=http://111.229.72.15

# ─── Phoenix 服务端 ────────────────────────────────────────────
# 用于签 cookie 的密钥，生产环境必须替换为随机串：
#   openssl rand -base64 64
SECRET_KEY_BASE=replace_me_with_openssl_rand_base64_64
# JWT token 签名密钥，生产环境必须替换为随机串：
#   openssl rand -base64 64
TOKEN_SIGNING_SECRET=replace_me_with_openssl_rand_base64_64
# 对外主机名（nginx 反代后，浏览器 Origin 是这个主机，check_origin 需要它匹配）。
# 注意：这是「公网访问主机名」，不是容器绑定 IP。
PHX_HOST=111.229.72.15

# ─── 数据库（外部 PostgreSQL）───────────────────────────────────
# 格式：postgres://USER:PASSWORD@HOST:PORT/DBNAME
# 需要和 Postgres 容器在同一 Docker 网络（knowledgehub_abp-network）
DATABASE_URL=postgres://postgres:postgres@postgres:5432/postgres
POOL_SIZE=10

# ─── 时区 ──────────────────────────────────────────────────────
TZ=Asia/Shanghai

# ─── 说明 ──────────────────────────────────────────────────────
# 容器端口固定在 127.0.0.1:4000（仅本机 nginx 访问），公网不暴露 4000。
# nginx (80) 已配置 proxy_pass http://127.0.0.1:4000。