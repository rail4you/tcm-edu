<Layouts.app flash={@flash} shell={:admin}>
  <.teacher_shell
    current_teacher={@current_teacher}
    current_page={:courses}
    page_title="创建课程"
    page_subtitle="先填基本信息，可顺手上传封面"
  >
    <:page_actions>
      <.link navigate="/teacher/courses" class="btn btn-soft btn-sm">返回列表</.link>
    </:page_actions>

    <.form
      for={@form}
      id="new-course-form"
      phx-change="validate"
      phx-submit="save"
      class="grid items-start gap-6 xl:grid-cols-3"
    >
      <div class="flex flex-col gap-6 xl:col-span-2">
        <fieldset class="fieldset rounded-box bg-base-100 p-4 shadow-sm sm:p-6">
          <legend class="fieldset-legend px-2 text-sm font-medium">基本信息</legend>
          <.input
            field={@form[:title]}
            type="text"
            label="课程标题"
            placeholder="如：中医基础理论（上）"
            maxlength="100"
            required
          />
          <p class="label">一句话讲清这门课教什么，学生端列表页直接展示</p>
          <.input
            field={@form[:subtitle]}
            type="text"
            label="副标题"
            placeholder="一句话介绍（可选）"
            maxlength="200"
          />
          <.input
            field={@form[:description]}
            type="textarea"
            label="课程简介"
            placeholder="课程介绍、适合人群、学习目标（可选）"
            rows="5"
            maxlength="2000"
          />
          <div class="flex flex-col gap-2">
            <span class="label">课程封面 <span class="text-base-content/50">（可选，JPG / PNG / WebP，≤ 5MB）</span></span>
            <label class="btn btn-soft btn-sm w-fit cursor-pointer">
              <.icon name="hero-photo" class="size-4" /> 选择封面图片
              <.live_file_input upload={@uploads.cover} class="hidden" />
            </label>
            <div :for={entry <- @uploads.cover.entries} class="flex items-center gap-2 text-sm">
              <.live_img_preview entry={entry} class="h-16 w-24 rounded object-cover" />
              <span class="max-w-48 truncate">{entry.client_name}</span>
              <button
                type="button"
                phx-click="cancel-cover"
                phx-value-ref={entry.ref}
                class="btn btn-ghost btn-xs"
              >
                移除
              </button>
            </div>
            <p :for={err <- upload_errors(@uploads.cover)} class="text-xs text-error">
              {TcmEduWeb.CourseCover.error_text(err)}
            </p>
          </div>
        </fieldset>

        <fieldset class="fieldset rounded-box bg-base-100 p-4 shadow-sm sm:p-6">
          <legend class="fieldset-legend px-2 text-sm font-medium">难度 · 价格 · 分类</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <.input field={@form[:level]} type="select" label="难度" options={level_options()} />
            <.input
              field={@form[:category_id]}
              type="select"
              label="分类"
              prompt="选择分类（可选）"
              options={Enum.map(@categories, &{&1.name, &1.id})}
            />
          </div>
          <.input
            field={@form[:price_yuan]}
            type="number"
            label="价格（元）"
            min="0"
            step="0.01"
          />
          <p class="label">0 表示免费课程，学生可直接选课</p>
        </fieldset>
      </div>

      <aside class="flex flex-col gap-6 xl:sticky xl:top-6">
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body gap-3 p-4 sm:p-6">
            <p class="flex items-center gap-2 font-medium">
              <.icon name="hero-light-bulb" class="size-5 text-warning" /> 备课小贴士
            </p>
            <ul class="flex list-disc flex-col gap-1 pl-5 text-sm text-base-content/80">
              <li>标题控制在 20 字以内，突出课程主题</li>
              <li>可顺手上传一张封面，学生端列表会更好看</li>
              <li>没有封面？用左侧链接去 AI 配图生成一张</li>
            </ul>
            <.link navigate="/teacher/ai/image" class="btn btn-soft btn-sm mt-2 w-fit">
              <.icon name="hero-photo" class="size-4" /> 去 AI 配图
            </.link>
          </div>
        </div>
        <div class="card bg-primary text-primary-content shadow-sm">
          <div class="card-body gap-3 p-4 sm:p-6">
            <p class="font-medium">准备好了吗？</p>
            <p class="text-sm opacity-80">创建后回到课程列表，可继续编辑与发布。</p>
            <.button type="submit" phx-disable-with="创建中..." class="btn border-0 bg-base-100">
              创建课程
            </.button>
          </div>
        </div>
      </aside>
    </.form>
  </.teacher_shell>
</Layouts.app>