<Layouts.app flash={@flash} shell={:storefront}>
    <.student_shell current_student={@current_student} current_page={:resources}>
      <div class="bg-gradient-to-r from-[#d9f9a3] via-[#c9f2cf] to-[#efffe1]">
        <div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6">
          <h1 class="text-3xl font-bold text-[#111] md:text-4xl">
            知识无界，<span class="text-[#00bd7b]">资料尽在掌握</span>
          </h1>
          <p class="mt-3 inline-block bg-[#c7efa9] px-3 py-2 text-lg text-[#333]">
            欢迎来到资料下载专区，一键解锁学习宝藏，让医者之路畅通无阻
          </p>
        </div>
      </div>

      <div class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6">
        <div class="flex flex-wrap gap-3">
          <button
            class={[
              "rounded-full border px-4 py-1.5 text-sm",
              @doc_type == "all" && "bg-white font-medium text-[#00b86b]",
              @doc_type == "all" || "border-base-300 bg-base-100 text-[#555]"
            ]}
            phx-click="filter-type"
            phx-value-doc_type="all"
            type="button"
            aria-label="全部资料"
          >
            全部资料
          </button>
          <button
            :for={{value, label} <- @doc_type_pills}
            class={[
              "rounded-full border px-4 py-1.5 text-sm",
              @doc_type == value && "bg-white font-medium text-[#00b86b]",
              @doc_type == value || "border-base-300 bg-base-100 text-[#555]"
            ]}
            phx-click="filter-type"
            phx-value-doc_type={value}
            type="button"
          >
            {label}
          </button>
        </div>

        <div class="mt-4 grid gap-4 bg-transparent py-4 lg:grid-cols-[1fr_260px]">
          <section class="bg-white p-0 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b p-5">
              <p class="border-l-4 border-[#00b86b] pl-3 text-xl font-bold">全部资料下载</p>
              <form phx-change="search" phx-submit="search" class="flex h-9 w-full max-w-sm border">
                <input
                  type="search"
                  name="keyword"
                  value={@keyword}
                  placeholder="关键字"
                  class="min-w-0 flex-1 px-3 text-sm outline-none"
                  aria-label="搜索资料"
                />
                <button type="submit" class="w-20 bg-[#00b86b] text-sm text-white">搜索</button>
              </form>
            </div>

            <p :if={visible(@docs, @keyword, @doc_type) == []} class="px-6 py-16 text-center text-sm text-[#999]">
              暂无匹配的资料，换个关键字或分类试试
            </p>

            <div :for={doc <- visible(@docs, @keyword, @doc_type)} class="flex items-center gap-5 border-b p-5 last:border-b-0">
              <span class={[
                "flex h-20 w-16 shrink-0 flex-col items-center justify-center rounded bg-gradient-to-br text-white",
                media_tone(doc.media_kind)
              ]}>
                <span class="text-lg font-semibold">{media_ext(doc.media_kind)}</span>
                <span class="text-[10px] opacity-80">{media_label(doc.media_kind)}</span>
              </span>
              <div class="min-w-0 flex-1">
                <p class="truncate text-base">{doc.title}</p>
                <p class="mt-1.5 line-clamp-1 text-xs text-[#999]">
                  {doc.source_name || (doc.content && String.slice(doc.content, 0, 60) || "")}
                </p>
                <div class="mt-1.5 text-xs text-[#999]">
                  {doc_type_label(doc.doc_type)}　|　共 1 个资料
                </div>
              </div>
              <span class="shrink-0 font-medium text-[#ff4d2f]">免费</span>
              <a
                :if={doc.asset_url}
                href={doc.asset_url}
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 rounded bg-[#00b86b] px-4 py-2 text-sm text-white transition hover:brightness-95"
              >
                资料下载
              </a>
              <span :if={!doc.asset_url} class="shrink-0 rounded bg-[#e5f8ef] px-4 py-2 text-sm text-[#00b86b]">
                资料下载
              </span>
            </div>
          </section>

          <aside class="flex flex-col gap-4">
            <div class="bg-white p-5 shadow-sm">
              <p class="border-l-4 border-[#00b86b] pl-3 text-xl font-bold">推荐题库</p>
              <div class="mt-4 bg-gradient-to-br from-[#effff9] to-[#b9f2dc] p-5 text-center text-lg text-[#333]">
                杏宁树中医题库<br />
                <span class="text-[#00b86b]">扫码进入题库</span>
              </div>
            </div>
            <div class="bg-white p-5 shadow-sm">
              <p class="border-l-4 border-[#00b86b] pl-3 text-xl font-bold">推荐课程</p>
              <.link navigate="/courses" class="link mt-3 block text-sm text-[#00b86b]">去精品课程逛逛 →</.link>
            </div>
          </aside>
        </div>
      </div>
    </.student_shell>
  </Layouts.app>