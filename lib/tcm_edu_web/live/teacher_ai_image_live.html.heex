<Layouts.app flash={@flash} shell={:admin}>
  <.teacher_shell
    current_teacher={@current_teacher}
    current_page={:ai_image}
    page_title="AI 配图"
    page_subtitle="生成经络腧穴、中药、示意图等教学配图，自动归档"
  >
    <div class="grid gap-6 xl:h-[calc(100dvh-244px)] xl:min-h-[32rem] xl:grid-cols-5">
      <div class="card border border-base-300 bg-base-100 xl:col-span-2 xl:min-h-0">
        <div class="card-body flex min-h-0 flex-col gap-3 p-4 sm:p-6 [&>p]:!grow-0">
          <p class="font-medium">作画需求</p>
          <.form
          for={@form}
          id="ai-image-form"
          phx-change="validate"
          phx-submit="generate"
          class="flex flex-col gap-3"
        >
          <.input
            field={@form[:prompt]}
            type="textarea"
            label="画面描述"
            placeholder="如：手太阴肺经循行示意图，标注主要腧穴，水墨风格"
            rows="4"
            maxlength="500"
            required
          />
          <div class="grid gap-3 sm:grid-cols-2">
            <.input field={@form[:style]} type="select" label="风格" options={style_options()} />
            <.input field={@form[:size]} type="select" label="尺寸" options={size_options()} />
          </div>
          <.button
            type="submit"
            phx-disable-with="生成中..."
            class="btn-primary mt-2 w-full"
            disabled={@generating}
          >
            <.icon name="hero-photo" class="size-4" /> 生成配图
          </.button>
        </.form>
          <p class="label">图片生成 + 归档约需半分钟；需要配置图片模型 Key 才能使用</p>
        </div>
      </div>

      <div class="card border border-base-300 bg-base-100 xl:col-span-3 xl:min-h-0">
        <div class="card-body flex min-h-0 flex-col gap-3 p-4 sm:p-6 [&>p]:!grow-0">
          <div class="flex items-center justify-between gap-2">
            <p class="font-medium">生成结果</p>
            <span :if={@job} class={["badge badge-soft badge-sm", status_badge(@job.status)]}>
              {status_text(@job.status)}
            </span>
          </div>

          <div
            :if={@generating}
            id="image-progress"
            class="flex flex-col gap-3 py-6"
          >
            <span class="loading loading-spinner loading-lg text-primary" />
            <div class="w-full max-w-sm">
              <progress class="progress progress-primary w-full" value={progress_of(@job)} max="100"></progress>
            </div>
            <p class="text-sm text-base-content/60">正在作画并归档，请稍候…（{progress_of(@job)}%）</p>
            <p class="text-xs text-base-content/50">可离开页面，完成后在「AI 任务管理」查看</p>
          </div>

          <div
            :if={!@generating and @job && @job.status == :failed}
            class="alert alert-soft alert-error py-3"
          >
            <.icon name="hero-exclamation-triangle" class="size-4" />
            <p class="text-sm">生成失败：{@job.error_message || "请稍后重试"}</p>
          </div>

          <p
            :if={!@generating and @urls == [] and (!@job || @job.status != :failed)}
            class="py-8 text-center text-sm text-base-content/60"
          >
            在左侧描述画面后点击生成
          </p>
          <div
            :if={@urls != []}
            class="grid min-h-0 flex-1 content-start gap-4 overflow-y-auto sm:grid-cols-2"
          >
            <form
              :for={{url, idx} <- Enum.with_index(@urls)}
              id={"set-cover-form-#{idx}"}
              phx-change="select-cover-course"
              class="flex flex-col gap-2"
            >
              <img src={url} alt="AI 生成的教学配图" loading="lazy" class="aspect-square w-full rounded-box object-cover" />
              <select name="cover[course_id]" class="select select-sm w-full" aria-label="选择课程">
                <option value="">设为封面：先选课程…</option>
                <option
                  :for={course <- @courses}
                  value={course.id}
                  selected={@cover_course_id == course.id}
                >
                  {course.title}
                </option>
              </select>
              <button
                type="button"
                phx-click="set-cover"
                phx-value-url={url}
                class="btn btn-soft btn-sm w-fit"
              >
                <.icon name="hero-photo" class="size-4" /> 设为该课程封面
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </.teacher_shell>
</Layouts.app>