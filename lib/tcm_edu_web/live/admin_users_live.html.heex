<Layouts.app flash={@flash} shell={:admin}>
  <.admin_shell current_admin={@current_admin} current_page={:users} page_title="用户管理">
    <:page_actions>
      <span :if={@current_admin.role == "super_admin"} class="flex items-center gap-2">
        <.form for={%{}} as={:tenant_filter} id="tenant-filter-form" phx-change="select-tenant" class="contents">
          <label class="form-control w-full" for="tenant-filter-select">
            <span class="sr-only">选择租户</span>
            <select
              id="tenant-filter-select"
              name="tenant"
              class="select select-sm w-64"
              aria-label="选择租户"
            >
              <option :for={t <- @tenants} value={t.schema_name} selected={t.schema_name == @tenant}>
                {t.name}（{t.schema_name}）
              </option>
            </select>
          </label>
        </.form>
      </span>
      <span :if={@current_admin.role != "super_admin"} class="badge badge-soft badge-info">
        {@tenant}
      </span>
      <a
        class="btn btn-soft"
        href="/admin/users/template"
        id="download-user-template-btn"
      >
        <.icon name="hero-arrow-down-tray" class="size-4" /> 下载导入模板
      </a>
      <button
        class="btn btn-soft"
        phx-click="open-import"
        id="import-users-btn"
        disabled={is_nil(@tenant)}
      >
        <.icon name="hero-arrow-up-tray" class="size-4" /> 批量导入
      </button>
      <button class="btn btn-primary" phx-click="open-create" id="new-user-btn" disabled={is_nil(@tenant)}>
        <.icon name="hero-plus" class="size-4" /> 创建用户
      </button>
    </:page_actions>

    <div class="card bg-base-100 shadow-sm">
      <div class="card-body gap-3 p-4 sm:p-6">
        <div class="flex flex-wrap items-center gap-2">
          <.form for={%{}} as={:role_filter} id="role-filter-form" phx-change="filter-role" class="contents">
            <label class="form-control w-full max-w-44" for="role-filter-select">
              <span class="sr-only">按角色筛选</span>
              <select
                id="role-filter-select"
                name="role"
                class="select select-sm w-full"
                aria-label="按角色筛选"
              >
                <option value="all" selected={@role_filter == "all"}>全部角色</option>
                <option value="tenant_admin" selected={@role_filter == "tenant_admin"}>
                  租户管理员
                </option>
                <option value="teacher" selected={@role_filter == "teacher"}>教师</option>
                <option value="student" selected={@role_filter == "student"}>学生</option>
              </select>
            </label>
          </.form>
          <p class="text-xs text-base-content/60">共 {length(@users)} 人</p>
        </div>
        <div class="overflow-x-auto rounded-box border border-base-300">
          <table class="table table-zebra table-pin-rows">
            <thead>
              <tr>
                <th>用户</th>
                <th>角色</th>
                <th>状态</th>
                <th class="text-right">操作</th>
              </tr>
            </thead>
            <tbody>
              <tr :for={user <- @users} class="hover:bg-base-200" id={"user-#{user.id}"}>
                <td>
                  <div class="flex items-center gap-3">
                    <span class="avatar avatar-placeholder">
                      <span class="flex size-10 items-center justify-center rounded-full bg-neutral text-sm text-neutral-content">
                        {user_initial(user)}
                      </span>
                    </span>
                    <div class="min-w-0">
                      <p class="truncate font-medium">{user.name || user.email}</p>
                      <p class="truncate text-xs text-base-content/60">{user.email}</p>
                    </div>
                  </div>
                </td>
                <td><.role_badge role={user.role} /></td>
                <td>
                  <span :if={user.status == :active} class="badge badge-soft badge-success">启用</span>
                  <span :if={user.status != :active} class="badge badge-soft badge-error">停用</span>
                </td>
                <td>
                  <div class="flex justify-end gap-1">
                    <button class="btn btn-ghost btn-sm" phx-click="open-role" phx-value-id={user.id}>
                      改角色
                    </button>
                    <button
                      :if={@current_admin.role == "super_admin"}
                      class="btn btn-ghost btn-sm"
                      id={"reset-password-#{user.id}"}
                      phx-click="open-password"
                      phx-value-id={user.id}
                    >
                      重置密码
                    </button>
                    <button
                      :if={user.status == :active}
                      class="btn btn-ghost btn-sm"
                      phx-click="set-status"
                      phx-value-id={user.id}
                      phx-value-status="disabled"
                    >
                      停用
                    </button>
                    <button
                      :if={user.status != :active}
                      class="btn btn-ghost btn-sm"
                      phx-click="set-status"
                      phx-value-id={user.id}
                      phx-value-status="active"
                    >
                      启用
                    </button>
                    <button
                      class="btn btn-ghost btn-sm text-error"
                      phx-click="confirm-delete"
                      phx-value-id={user.id}
                    >
                      删除
                    </button>
                  </div>
                </td>
              </tr>
              <tr :if={@users == []}>
                <td colspan="100%">
                  <div class="flex flex-col items-center gap-2 py-10">
                    <.icon name="hero-users" class="size-8 text-base-content/40" />
                    <p class="text-sm text-base-content/60">该租户还没有用户</p>
                    <button class="btn btn-primary btn-sm" phx-click="open-create">
                      创建第一个用户
                    </button>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div :if={@modal == :create} class="modal modal-open" role="dialog" aria-modal="true">
      <div class="modal-box">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-lg font-medium">创建用户</p>
            <p class="mt-1 text-xs text-base-content/60">目标租户：<code>{@tenant}</code></p>
          </div>
          <button class="btn btn-circle btn-ghost btn-sm" phx-click="close-modal" aria-label="关闭">
            <.icon name="hero-x-mark" class="size-4" />
          </button>
        </div>
        <.form
          for={@create_form}
          id="create-user-form"
          phx-change="validate-create"
          phx-submit="create"
          class="mt-4 flex flex-col gap-3"
        >
          <.input field={@create_form[:email]} type="email" label="邮箱" placeholder="user@example.com" required />
          <.input field={@create_form[:name]} type="text" label="姓名" placeholder="可选" />
          <.input field={@create_form[:password]} type="password" label="初始密码" placeholder="至少 6 位" required />
          <.input field={@create_form[:role]} type="select" label="角色" options={role_options(@current_admin.role)} />
          <div class="modal-action">
            <button type="button" class="btn btn-soft" phx-click="close-modal">取消</button>
            <.button type="submit" phx-disable-with="创建中..." class="btn-primary">创建</.button>
          </div>
        </.form>
      </div>
      <div class="modal-backdrop" phx-click="close-modal"></div>
    </div>

    <div :if={@modal == :role} class="modal modal-open" role="dialog" aria-modal="true">
      <div class="modal-box">
        <div class="flex items-start justify-between gap-4">
          <p class="text-lg font-medium">修改角色：{(@role_editing && @role_editing.email) || ""}</p>
          <button class="btn btn-circle btn-ghost btn-sm" phx-click="close-modal" aria-label="关闭">
            <.icon name="hero-x-mark" class="size-4" />
          </button>
        </div>
        <.form for={@role_form} id="edit-role-form" phx-submit="save-role" class="mt-4 flex flex-col gap-3">
          <.input field={@role_form[:role]} type="select" label="角色" options={role_options(@current_admin.role)} />
          <div class="modal-action">
            <button type="button" class="btn btn-soft" phx-click="close-modal">取消</button>
            <.button type="submit" phx-disable-with="保存中..." class="btn-primary">保存</.button>
          </div>
        </.form>
      </div>
      <div class="modal-backdrop" phx-click="close-modal"></div>
    </div>

    <div :if={@modal == :password} class="modal modal-open" role="dialog" aria-modal="true">
      <div class="modal-box">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-lg font-medium">重置密码：{(@password_editing && @password_editing.email) || ""}</p>
            <p class="mt-1 text-xs text-base-content/60">新密码即刻生效，该用户需用新密码重新登录。</p>
          </div>
          <button class="btn btn-circle btn-ghost btn-sm" phx-click="close-modal" aria-label="关闭">
            <.icon name="hero-x-mark" class="size-4" />
          </button>
        </div>
        <.form
          for={@password_form}
          id="reset-password-form"
          phx-change="validate-password"
          phx-submit="save-password"
          class="mt-4 flex flex-col gap-3"
        >
          <.input field={@password_form[:password]} type="password" label="新密码" placeholder="至少 6 位" required />
          <.input
            field={@password_form[:password_confirmation]}
            type="password"
            label="确认新密码"
            placeholder="再次输入新密码"
            required
          />
          <div class="modal-action">
            <button type="button" class="btn btn-soft" phx-click="close-modal">取消</button>
            <.button type="submit" phx-disable-with="保存中..." class="btn-primary">保存新密码</.button>
          </div>
        </.form>
      </div>
      <div class="modal-backdrop" phx-click="close-modal"></div>
    </div>

    <div :if={@modal == :delete} class="modal modal-open" role="dialog" aria-modal="true">
      <div class="modal-box">
        <p class="text-lg font-medium">删除用户 {(@deleting && @deleting.email) || ""}？</p>
        <div class="alert alert-soft alert-error mt-3">
          <.icon name="hero-exclamation-triangle" class="size-5" />
          <p class="text-sm">该操作不可恢复，请确认。</p>
        </div>
        <div class="modal-action">
          <button type="button" class="btn btn-soft" phx-click="close-modal">取消</button>
          <button type="button" class="btn btn-error" phx-click="delete" id="confirm-delete-btn">
            确认删除
          </button>
        </div>
      </div>
      <div class="modal-backdrop" phx-click="close-modal"></div>
    </div>

    <div :if={@import_modal} class="modal modal-open" role="dialog" aria-modal="true">
      <div class="modal-box max-w-2xl">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-lg font-medium">批量导入用户</p>
            <p class="mt-1 text-xs text-base-content/60">
              目标租户：<code>{@tenant}</code>。先
              <a class="link" href="/admin/users/template" target="_blank">下载导入模板</a>
              填写（角色列只能从下拉列表选择），再上传，一次最多 {AdminUserImport.max_rows()} 行
            </p>
          </div>
          <button class="btn btn-circle btn-ghost btn-sm" phx-click="close-import" aria-label="关闭">
            <.icon name="hero-x-mark" class="size-4" />
          </button>
        </div>

        <form
          :if={is_nil(@import_result)}
          id="import-users-form"
          phx-change="validate-import"
          phx-submit="import"
          class="mt-4 flex flex-col gap-3"
        >
          <label class="form-control w-full">
            <span class="label-text mb-1 block text-sm">导入文件（.xlsx）</span>
            <.live_file_input upload={@uploads.import_file} class="file-input file-input-bordered w-full" />
          </label>
          <ul :for={entry <- @uploads.import_file.entries} class="flex flex-col gap-1">
            <li class="flex items-center gap-2 text-sm">
              <.icon name="hero-document" class="size-4 text-base-content/60" />
              <span class="truncate">{entry.client_name}</span>
              <button
                type="button"
                class="btn btn-ghost btn-xs"
                phx-click="cancel-upload"
                phx-value-ref={entry.ref}
                aria-label={"移除 #{entry.client_name}"}
              >
                <.icon name="hero-x-mark" class="size-4" />
              </button>
            </li>
          </ul>
          <p :for={err <- upload_errors(@uploads.import_file)} class="text-xs text-error">
            {upload_error_to_string(err)}
          </p>
          <div class="modal-action">
            <button type="button" class="btn btn-soft" phx-click="close-import">取消</button>
            <.button type="submit" phx-disable-with="导入中..." class="btn-primary" id="start-user-import-btn">
              开始导入
            </.button>
          </div>
        </form>

        <div :if={@import_result} class="mt-4 flex flex-col gap-3">
          <div class="alert alert-soft alert-success">
            <.icon name="hero-check-circle" class="size-5" />
            <p class="text-sm">成功导入 {@import_result.created} 个用户</p>
          </div>
          <div :if={@import_result.failed != []} class="overflow-x-auto rounded-box border border-base-300">
            <table class="table table-zebra table-sm">
              <thead>
                <tr>
                  <th>Excel 行号</th>
                  <th>原因</th>
                </tr>
              </thead>
              <tbody>
                <tr :for={{row, message} <- @import_result.failed} id={"user-import-error-#{row}"}>
                  <td class="tabular-nums">{row}</td>
                  <td class="text-sm">{message}</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="modal-action">
            <button type="button" class="btn btn-primary" phx-click="close-import" id="finish-user-import-btn">
              完成
            </button>
          </div>
        </div>
      </div>
      <div class="modal-backdrop" phx-click="close-import"></div>
    </div>
  </.admin_shell>
</Layouts.app>
