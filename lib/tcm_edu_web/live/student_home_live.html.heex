<Layouts.app flash={@flash} shell={:storefront}>
    <.student_shell current_student={@current_student} current_page={:home} unread_count={@unread_count}>
      <section class="relative overflow-hidden bg-gradient-to-br from-[#08a9b9] via-[#00c991] to-[#00b86b] text-white">
        <div class="absolute -right-10 -top-8 size-56 rounded-full border-[24px] border-white/25"></div>
        <div class="absolute right-28 top-10 text-[80px] font-black text-white/20">◉</div>
        <div class="mx-auto grid w-full max-w-6xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-[1.4fr_1fr] lg:items-center">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[2px] text-white/80">杏宁树 · 中医教育数字化</p>
            <h1 class="mt-3 text-4xl font-black tracking-tight md:text-5xl">系统学中医，<br />从这里开始</h1>
            <p class="mt-4 max-w-md text-sm text-white/85">
              从基础理论到临床精进，选课、看课、进度跟踪，全程免费起步。
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <.link navigate="/courses" class="rounded-full bg-[#ffd817] px-8 py-3 text-base font-bold text-[#111] transition hover:brightness-95">
                浏览课程 →
              </.link>
              <.link
                navigate={if @current_student, do: "/my-learning", else: "/login"}
                class="rounded-full border-2 border-white/60 px-8 py-3 text-base font-medium text-white transition hover:bg-white/10"
              >
                {if @current_student, do: "继续学习", else: "登录"}
              </.link>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-lg bg-white/15 p-5 backdrop-blur-sm">
              <p class="text-3xl font-bold tabular-nums">{@courses |> Enum.map(&(&1.lesson_count || 0)) |> Enum.sum()}</p>
              <p class="mt-1 text-xs text-white/80">精选课时</p>
            </div>
            <div class="rounded-lg bg-white/15 p-5 backdrop-blur-sm">
              <p class="text-3xl font-bold tabular-nums">{length(@teachers)}</p>
              <p class="mt-1 text-xs text-white/80">一线教师</p>
            </div>
            <div class="rounded-lg bg-white/15 p-5 backdrop-blur-sm">
              <p class="text-3xl font-bold tabular-nums">{length(@courses)}</p>
              <p class="mt-1 text-xs text-white/80">热门课程</p>
            </div>
            <div class="rounded-lg bg-white/15 p-5 backdrop-blur-sm">
              <p class="text-3xl font-bold tabular-nums">{@courses |> Enum.map(&(&1.student_count || 0)) |> Enum.sum()}</p>
              <p class="mt-1 text-xs text-white/80">在学人次</p>
            </div>
          </div>
        </div>
      </section>

      <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6">
        <section>
          <div class="mb-4 flex flex-wrap items-center gap-x-8 gap-y-4 border-b border-[#ddd] pb-4 text-sm font-semibold">
            <span class="rounded bg-[#00c98a] px-3 py-1 text-white">全部课程分类</span>
            <.link
              :for={category <- @categories}
              navigate={"/courses?category_id=#{category.id}"}
              class="text-[#555] transition hover:text-[#00b86b]"
            >
              {category.name}
            </.link>
          </div>
          <p :if={@categories == []} class="pb-4 text-sm text-[#999]">分类筹备中</p>
        </section>

        <section class="mt-8">
          <div class="mb-5 flex items-center justify-between">
            <div>
              <p class="text-2xl font-bold">大家都在学</p>
              <p class="mt-1 text-sm text-[#888]">按在学人数排序的热门课程，免费试看先行</p>
            </div>
            <.link navigate="/courses" class="text-sm text-[#00b86b] hover:underline">更多课程 →</.link>
          </div>
          <div :if={@courses != []} class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <.course_card :for={course <- @courses} course={course} id={"home-course-#{course.id}"} />
          </div>
          <p :if={@courses == []} class="rounded bg-white px-6 py-12 text-center text-sm text-[#999] shadow-sm">
            课程正在筹备中，敬请期待。
          </p>
          <p :if={!@current_student and @courses != []} class="mt-6 text-center text-sm text-[#888]">
            登录后即可选课学习，进度云端同步。
            <.link navigate="/login" class="font-medium text-[#00b86b] hover:underline">去登录 →</.link>
          </p>
        </section>

        <section :if={@teachers != []} class="mt-12">
          <div class="mb-5 flex items-center justify-between">
            <div>
              <p class="text-2xl font-bold">名师风采</p>
              <p class="mt-1 text-sm text-[#888]">一线教师精讲每一门课</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
            <div :for={teacher <- @teachers} class="flex items-center gap-3 bg-white p-4 shadow-sm">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-[#00b86b] text-lg font-bold text-white">
                {teacher.name |> String.first() |> String.upcase()}
              </span>
              <div class="min-w-0">
                <p class="truncate font-medium">{teacher.name}</p>
                <p class="mt-0.5 truncate text-xs text-[#888]">{teacher.job_title || teacher.school || "教师"}</p>
              </div>
            </div>
          </div>
        </section>

        <section class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-3">
          <a href="/resources" class="flex items-center gap-4 bg-white px-5 py-5 shadow-sm transition hover:shadow-md">
            <span class="text-4xl text-[#00b86b]">▥</span>
            <div>
              <p class="font-bold">资料下载</p>
              <p class="mt-1 text-sm text-[#888]">资料一网打尽，尽在掌握</p>
            </div>
          </a>
          <a href="/courses" class="flex items-center gap-4 bg-white px-5 py-5 shadow-sm transition hover:shadow-md">
            <span class="text-4xl text-[#00b86b]">◇</span>
            <div>
              <p class="font-bold">精品课程</p>
              <p class="mt-1 text-sm text-[#888]">名师领航 专项突破 助力逐梦</p>
            </div>
          </a>
          <a href="/simulated-patient" class="flex items-center gap-4 bg-white px-5 py-5 shadow-sm transition hover:shadow-md">
            <span class="text-4xl text-[#00b86b]">♙</span>
            <div>
              <p class="font-bold">AI 智能诊疗</p>
              <p class="mt-1 text-sm text-[#888]">AI 问诊实操，练出临床思维</p>
            </div>
          </a>
        </section>
      </div>
    </.student_shell>
  </Layouts.app>