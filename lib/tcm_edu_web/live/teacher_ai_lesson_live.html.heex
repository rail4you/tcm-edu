<Layouts.app flash={@flash} shell={:admin}>
  <.teacher_shell
    current_teacher={@current_teacher}
    current_page={:ai_lesson}
    page_title="AI 备课"
    page_subtitle="输入主题，AI 生成结构化教案，可一键存为课程草稿"
  >
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <p :if={@plan_topic} class="text-sm text-base-content/60">
        主题：<span class="font-medium text-base-content">{@plan_topic}</span>
      </p>
      <div class="flex gap-2">
        <button class="btn btn-primary btn-sm" phx-click="open-form">
          <.icon name="hero-pencil-square" class="size-4" />
          {if @plan, do: "修改备课需求", else: "填写备课需求"}
        </button>
        <button
          :if={@plan}
          class="btn btn-primary btn-sm"
          phx-click="save-draft"
          phx-disable-with="保存中..."
        >
          <.icon name="hero-plus" class="size-4" /> 存为课程草稿
        </button>
      </div>
    </div>

    <div class="card border border-base-300 bg-base-100">
      <div class="card-body gap-3 p-4 sm:p-6">
        <div class="flex items-center justify-between gap-2">
          <p class="font-medium">生成结果</p>
          <span :if={@job} class={["badge badge-soft badge-sm", status_badge(@job.status)]}>
            {status_text(@job.status)}
          </span>
        </div>

        <div :if={@generating} id="lesson-progress" class="flex flex-col gap-3 py-6">
          <div class="flex items-center justify-between text-xs text-base-content/60">
            <span class="flex items-center gap-2">
              <span class="loading loading-dots loading-sm" /> AI 正在撰写教案…
            </span>
            <span class="tabular-nums">{progress_of(@job)}%</span>
          </div>
          <progress class="progress progress-primary w-full" value={progress_of(@job)} max="100"></progress>
          <p class="text-xs text-base-content/50">
            可离开页面，完成后在「AI 任务管理」查看；回到本页会自动恢复进度。
          </p>
        </div>

        <div
          :if={!@generating and @job && @job.status == :failed}
          class="alert alert-soft alert-error py-3"
        >
          <.icon name="hero-exclamation-triangle" class="size-4" />
          <p class="text-sm">生成失败：{@job.error_message || "请稍后重试"}</p>
        </div>

        <p
          :if={!@generating and !@plan and (!@job || @job.status != :failed)}
          class="py-8 text-center text-sm text-base-content/60"
        >
          点击「填写备课需求」开始生成
        </p>
        <div :if={@plan} id="plan-table" class="overflow-x-auto">
          <table class="table table-zebra w-full text-sm">
            <thead>
              <tr>
                <th class="w-12">序号</th>
                <th>教案</th>
                <th class="w-20 text-right">小节</th>
                <th class="w-20 text-right">操作</th>
              </tr>
            </thead>
            <tbody>
              <tr id="plan-row-0">
                <td class="tabular-nums text-base-content/60">1</td>
                <td>
                  <p class="max-w-2xl truncate font-medium">{@plan_topic || "AI 教案"}</p>
                  <p class="text-xs text-base-content/60">AI 生成的结构化教案（markdown）</p>
                </td>
                <td class="text-right tabular-nums text-base-content/60">
                  {length(@plan_doc.toc)}
                </td>
                <td class="text-right">
                  <button
                    type="button"
                    class="btn btn-ghost btn-xs"
                    phx-click="open-detail"
                    id="plan-detail-0"
                  >
                    <.icon name="hero-document-magnifying-glass" class="size-3.5" /> 详情
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div :if={@detail} class="modal modal-open" role="dialog" aria-modal="true">
      <div class="modal-box flex h-[calc(100dvh-4rem)] max-w-4xl flex-col">
        <div class="flex shrink-0 items-start justify-between gap-4">
          <div>
            <p class="text-lg font-medium">{@plan_topic || "AI 教案"}</p>
            <p class="mt-1 text-xs text-base-content/60">AI 生成的结构化教案</p>
          </div>
          <button class="btn btn-circle btn-ghost btn-sm" phx-click="close-detail" aria-label="关闭">
            <.icon name="hero-x-mark" class="size-4" />
          </button>
        </div>

        <div class="mt-4 flex min-h-0 flex-1 gap-4">
          <nav
            :if={@detail.toc != []}
            class="hidden w-48 shrink-0 overflow-y-auto lg:block"
            aria-label="教案导航"
          >
            <p class="mb-1 text-xs font-medium text-base-content/60">目录</p>
            <ul class="menu w-full gap-0.5 text-sm">
              <li :for={item <- @detail.toc}>
                <a href={"##{item.id}"} class={item.level > 1 && "ps-7 text-base-content/70"}>
                  {item.text}
                </a>
              </li>
            </ul>
          </nav>
          <div class="ai-markdown min-h-0 min-w-0 flex-1 overflow-y-auto pe-1 text-sm leading-7 [&_blockquote]:border-s-2 [&_blockquote]:border-base-300 [&_blockquote]:ps-3 [&_blockquote]:text-base-content/70 [&_code]:rounded [&_code]:bg-base-300/60 [&_code]:px-1 [&_h1]:mt-3 [&_h1]:text-lg [&_h1]:font-bold [&_h2]:mt-3 [&_h2]:text-base [&_h2]:font-bold [&_h3]:mt-2 [&_h3]:text-sm [&_h3]:font-semibold [&_hr]:my-3 [&_hr]:border-base-300 [&_li]:mt-0.5 [&_ol]:list-decimal [&_ol]:ps-5 [&_p]:my-1 [&_pre]:overflow-x-auto [&_pre]:rounded-lg [&_pre]:bg-base-300/50 [&_pre]:p-2 [&_strong]:font-semibold [&_table]:table [&_td]:border [&_td]:border-base-300 [&_td]:px-2 [&_td]:py-1 [&_th]:border [&_th]:border-base-300 [&_th]:bg-base-300/40 [&_th]:px-2 [&_th]:py-1 [&_ul]:list-disc [&_ul]:ps-5">
            {Phoenix.HTML.raw(@detail.html)}
          </div>
        </div>

        <div class="modal-action shrink-0">
          <button type="button" class="btn btn-soft" phx-click="close-detail">关闭</button>
        </div>
      </div>
      <div class="modal-backdrop" phx-click="close-detail"></div>
    </div>

    <div :if={@show_form} class="modal modal-open" role="dialog" aria-modal="true">
      <div class="modal-box">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold">备课需求</h3>
          <button class="btn btn-ghost btn-sm btn-circle" phx-click="close-form" aria-label="关闭">
            <.icon name="hero-x-mark" class="size-5" />
          </button>
        </div>
        <.form
          for={@form}
          id="ai-lesson-form"
          phx-change="validate"
          phx-submit="generate"
          class="mt-4 flex flex-col gap-3"
        >
          <.input field={@form[:topic]} type="text" label="主题" placeholder="如：手太阴肺经腧穴" maxlength="100" required />
          <.input field={@form[:subject]} type="text" label="学科" placeholder="如：中医基础（可选）" maxlength="50" />
          <.input field={@form[:level]} type="select" label="学段" options={level_options()} />
          <.input field={@form[:audience]} type="select" label="授课对象" options={audience_options()} />
          <div class="modal-action">
            <button type="button" class="btn btn-ghost" phx-click="close-form">取消</button>
            <.button
              type="submit"
              phx-disable-with="生成中..."
              class="btn-primary"
              disabled={@generating}
            >
              <.icon name="hero-sparkles" class="size-4" /> 生成教案
            </.button>
          </div>
        </.form>
        <p class="label mt-2">生成约需十几秒，请耐心等待；需要配置大模型 Key 才能使用</p>
      </div>
      <div class="modal-backdrop" phx-click="close-form"></div>
    </div>
  </.teacher_shell>
</Layouts.app>
