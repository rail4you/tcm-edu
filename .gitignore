# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Playwright CLI verification artifacts (snapshots, logs, traces)
/.playwright-cli/

# Ignore package tarball (built via "mix hex.build").
tcm_edu-*.tar

# Phoenix assets pipeline (Tailwind v4 + daisyUI + esbuild in assets/):
# npm deps and compiled output are rebuilt via `mix assets.setup/build`.
/assets/node_modules/
/priv/static/assets/

# Local secrets (LLM keys, admin passwords). Never commit.
.env
.env.*

# Android native build: signing keystore + passphrases + machine paths,
# Gradle/CMake caches and the packaged OTP runtime. The android/ source
# tree itself is tracked.
/mobile/android/upload_jks.keystore
/mobile/android/keystore.properties
/mobile/android/local.properties
/mobile/android/build/
/mobile/android/app/build/
/mobile/android/app/.cxx/
/mobile/android/.gradle/
/mobile/android/app/src/release/assets/otp.zip
